# Standalone test (no rover needed)
# ─────────────────────────────────────────────

if __name__ == "__main__":
    """
    Loopback test: starts CommsManager and sends fake telemetry
    back to itself to verify TX/RX plumbing.
    Press Ctrl+C to stop.
    """
    import sys

    print("[B4] Standalone loopback test")
    print("     Sending fake telemetry to localhost:5001")
    print("     Ctrl+C to stop\n")

    # Minimal AppState stub
    class _Lock:
        def __enter__(self): return self
        def __exit__(self, *a): pass

    class _Telemetry:
        battery_v = 0.0
        uptime_s  = 0.0
        temp_c    = 0.0
        link_ok   = False
        last_rx   = 0.0

    class _Command:
        throttle = 0.0
        steering = 0.0
        stop     = False
        capture  = False

    class _State:
        telemetry  = _Telemetry()
        command    = _Command()
        latest_frame = None
        alerts     = []
        frame_lock = _Lock()
        cmd_lock   = _Lock()

    state = _State()

    # Fake rover: sends telemetry packets to ourselves
    def fake_rover():
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        v, uptime = 8.1, 0
        while True:
            payload = json.dumps({
                "battery_v": round(v, 2),
                "uptime_s":  uptime,
                "temp_c":    45.0,
            }).encode()
            sock.sendto(payload, ("127.0.0.1", TELEMETRY_PORT))
            v      -= 0.01
            uptime += 1
            time.sleep(1.0)

    threading.Thread(target=fake_rover, daemon=True).start()

    comms = CommsManager(rover_ip="127.0.0.1")
    comms.start(state)

    try:
        while True:
            t = state.telemetry
            print(f"[B4] Link={t.link_ok}  Batt={t.battery_v:.2f}V  "
                  f"Temp={t.temp_c:.1f}°C  Uptime={t.uptime_s:.0f}s  "
                  f"TX={comms.link.packets_tx}  RX={comms.link.packets_rx}")
            time.sleep(2.0)
    except KeyboardInterrupt:
        comms.stop()
        print("\n[B4] Test complete.")
        print(f"     Final link status: {comms.status}")
